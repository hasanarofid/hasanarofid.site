RewriteEngine On

# 0. Canonical Domain & Subdomain Fix (Redirect www, mail, dll ke domain utama)
RewriteCond %{HTTP_HOST} !^studio\.hasanarofid\.site$ [NC]
RewriteCond %{HTTP_HOST} !^hasanarofid\.site$ [NC]
RewriteRule ^(.*)$ https://hasanarofid.site/$1 [R=301,L]

# 0. Force HTTPS
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# 0. Redirect old/renamed article slugs
RewriteRule ^blog/tutorial-jwt-authentication-implementasi-refresh-token-rate-limiting$ /blog/panduan-membangun-api-restful-aman-dengan-jwt-dan-rate-limiting [R=301,L]

# 1. Redirect index.php to root /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.php\ HTTP/
RewriteRule ^index\.php$ / [R=301,L]

# 2. Redirect portofolio?project=slug or portofolio.php?project=slug to /portofolio/slug
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /portofolio(\.php)?\?project=([a-zA-Z0-9-]+)\ HTTP/ [NC]
RewriteRule ^ /portofolio/%2? [R=301,L]

# 3. Redirect blog?slug=slug or blog.php?slug=slug to /blog/slug
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /blog(\.php)?\?slug=([a-zA-Z0-9-]+)\ HTTP/ [NC]
RewriteRule ^ /blog/%2? [R=301,L]

# 4. Redirect direct request to static .php files to extensionless URLs
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(about|articles|contact|disclaimer|portofolio|privacy-policy|products|terms-of-service|trafik)\.php\ HTTP/ [NC]
RewriteRule ^([a-zA-Z0-9_-]+)\.php$ /$1 [R=301,L]

# 4b. Redirect URLs with trailing slash to non-trailing slash (except directories)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# 5. Route blog slugs
RewriteRule ^blog/([a-zA-Z0-9-]+)$ blog.php?slug=$1 [QSA,L]

# 6. Route portfolio slugs
RewriteRule ^portofolio/([a-zA-Z0-9-]+)$ portofolio.php?project=$1 [QSA,L]

# 7. Internal rewrite for extensionless URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([a-zA-Z0-9_-]+)$ $1.php [QSA,L]
